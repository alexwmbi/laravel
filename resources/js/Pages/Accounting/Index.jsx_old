import React from "react"; // IMPORTAZIONE AGGIUNTA
import TextInput from "@/Components/TextInput";
import AuthenticatedLayout from "@/Layouts/AuthenticatedLayout";
import SelectInput from "@/Components/SelectInput";
import { Head, Link, router } from "@inertiajs/react";
import {
  ACCOUNTING_STATUS_CLASS_MAP,
  ACCOUNTING_STATUS_TEXT_MAP,
} from "@/constants.jsx";
import {
  PencilSquareIcon,
  TrashIcon,
  EyeIcon,
} from "@heroicons/react/24/solid";
import Pagination from "@/Components/Pagination";

export default function Index({
  auth,
  accountings,
  queryParams = null,
  success,
}) {
  queryParams = queryParams || {};
  const searchFieldChanged = (name, value) => {
    if (value) {
      queryParams[name] = value;
    } else {
      delete queryParams[name];
    }
    router.get(route("accounting.index"), queryParams);
  };

  const onKeyPress = (name, e) => {
    if (e.key !== "Enter") return;
    searchFieldChanged(name, e.target.value);
  };

  const sortChanged = (name) => {
    if (name === queryParams.sort_field) {
      queryParams.sort_direction =
        queryParams.sort_direction === "asc" ? "desc" : "asc";
    } else {
      queryParams.sort_field = name;
      queryParams.sort_direction = "asc";
    }
    router.get(route("accounting.index"), queryParams);
  };

  const deleteAccount = (accounting) => {
    if (!window.confirm("Vuoi eliminare la fattura acquisto?")) {
      return;
    }
    router.delete(route("accounting.destroy", accounting.id));
  };

  return (
    <AuthenticatedLayout
      user={auth.user}
      header={
        <div className="flex justify-between items-center">
          <h2 className="font-semibold text-xl text-gray-800 dark:text-gray-200 leading-tight">
            Contabilità
          </h2>
          <Link
            href={route("accounting.create")}
            className="bg-emerald-200 py-1 px-3 text-emerald-500 rounded shadow transition-all hover:bg-emerald-400 hover:text-white"
          >
            Importa Fattura Acquisto
          </Link>
        </div>
      }
    >
      <Head title="Contabilità" />
      {success && (
        <div className="bg-emerald-500 py-2 px-4 text-white rounded">
          {success}
        </div>
      )}
      <div className="py-12">
        <div className="max-w-7xl mx-auto sm:px-6 lg:px-8">
          <div className="bg-white dark:bg-gray-800 overflow-hidden shadow-sm sm:rounded-lg">
            <div className="p-6 text-gray-900 dark:text-gray-100">
              <table className=" w-full text-left text-sm rtl:text-right text-gray-500 dark:text-gray-400">
                <thead className="text-xs text-gray-700 uppercase">
                  <tr>
                    <th className="px-3 py-2">PROGRESSIVO</th>
                    <th className="px-3 py-2">PROGRESSIVO INVIO</th>
                    <th className="px-3 py-2">FORNITORE</th>
                    <th className="px-3 py-2">NUMERO</th>
                    <th className="px-3 py-2">DATA</th>
                    <th className="px-3 py-2">TOTALE</th>
                    {/* <th className="px-3 py-2">AZIONI</th> */}
                  </tr>
                </thead>
                <thead className="text-xs text-gray-700 uppercase">
                  <tr className="text-nowrap">
                  {/*   <th className="px-3 py-2 ">
                      <SelectInput
                        className="w-full"
                        defaultValue={queryParams.stato}
                        onChange={(e) =>
                          searchFieldChanged("stato", e.target.value)
                        }
                      >
                        <option value="">Seleziona Stato</option>
                        <option value="aperta">Da Pagare</option>
                        <option value="archivata">Archiviata</option>
                      </SelectInput>
                    </th> */}
                    <th className="px-3 py-2">
                      <TextInput
                        className="w-full"
                        defaultValue={queryParams.progressivo}
                        placeholder="Progressivo"
                        onBlur={(e) =>
                          searchFieldChanged("progressivo", e.target.value)
                        }
                        onKeyPress={(e) => onKeyPress("progressivo", e)}
                      />
                    </th>
                    <th className="px-3 py-2">
                      <TextInput
                        className="w-full"
                        defaultValue={queryParams.progressivoinvio}
                        placeholder="Progressivo Invio"
                        onBlur={(e) =>
                          searchFieldChanged("progressivoinvio", e.target.value)
                        }
                        onKeyPress={(e) => onKeyPress("progressivoinvio", e)}
                      />
                    </th>
                    <th className="px-3 py-2">
                      <TextInput
                        className="w-full"
                        defaultValue={queryParams.name}
                        placeholder="Fornitore"
                        onBlur={(e) =>
                          searchFieldChanged("name", e.target.value)
                        }
                        onKeyPress={(e) => onKeyPress("name", e)}
                      />
                    </th>
                    <th className="px-3 py-2">
                      <TextInput
                        className="w-full"
                        defaultValue={queryParams.numero}
                        placeholder="Numero"
                        onBlur={(e) =>
                          searchFieldChanged("numero", e.target.value)
                        }
                        onKeyPress={(e) => onKeyPress("numero", e)}
                      />
                    </th>
                    <th className="px-3 py-2"></th>
                    <th className="px-3 py-2"></th>
                    <th className="px-3 py-2"></th>
                  </tr>
                 
                </thead>
                <tbody>
                  {accountings.data.map((accounting) => (
                    <React.Fragment key={accounting.id}>

                     <tr className="text-xs bg-gray-200 text-gray-700 uppercase">
      <th className="px-3 py-2 text-left">PROGRESSIVO</th>
      <th className="px-3 py-2 text-left">PROGRESSIVO INVIO</th>
      <th className="px-3 py-2 text-left">FORNITORE</th>
      <th className="px-3 py-2 text-left">NUMERO</th>
      <th className="px-3 py-2 text-left">DATA</th>
      <th className="px-3 py-2 text-left">TOTALE</th>
      <th className="px-3 py-2 text-left">AZIONI</th>
    </tr>
                     
                      <tr className="bg-white border-b dark:bg-gray-700 dark:border-gray-700 hover:bg-purple-100  pt-6">
                        {/*  <td className="px-3 py-2">
                          <span
                            className={
                              "px-2 py-1 rounded text-white " +
                              ACCOUNTING_STATUS_CLASS_MAP[accounting.Stato]
                            }
                          >
                            {ACCOUNTING_STATUS_TEXT_MAP[accounting.Stato]}
                          </span>
                        </td> */}
                       {/*  <td className="px-3 py-2">
                          <span
                            className={
                              "px-2 py-1 rounded text-white " +
                              ACCOUNTING_STATUS_CLASS_MAP[
                                accounting.detail_accounting?.some(
                                  (detail) => detail.stato === "aperta"
                                )
                                  ? "aperta"
                                  : "archivata"
                              ]
                            }
                          >
                            {
                              ACCOUNTING_STATUS_TEXT_MAP[
                                accounting.detail_accounting?.some(
                                  (detail) => detail.stato === "aperta"
                                )
                                  ? "aperta"
                                  : "archivata"
                              ]
                            }
                          </span>
                        </td> */}
 <td className="px-3 py-2">
                         {accounting.Progressivo}
                        </td>
                        <td className="px-3 py-2">
                          {accounting.ProgressivoInvio}
                        </td>
                        <td className="px-3 py-2">
                          {accounting.FornitoreNome}
                        </td>
                        <td className="px-3 py-2">{accounting.Numero}</td>
                        <td className="px-3 py-2">{accounting.Data}</td>
                        <td className="px-3 py-2">
                          {accounting.ImportoTotaleDocumento}
                        </td>
                        <td className="px-3 py-2 flex space-x-2">
                          {/* <Link
                            href={route("accounting.show", accounting.id)}
                            className="font-medium text-emerald-600"
                          >
                            <EyeIcon className="w-5 h-5" />
                          </Link>
                          <Link
                            href={route("accounting.edit", accounting.id)}
                            className="font-medium text-blue-600"
                          >
                            <PencilSquareIcon className="w-5 h-5" />
                          </Link> */}
                          <Link
                            href={route("accounting.editprog", accounting.id)}
                            className="font-medium text-blue-600"
                          >
                            <PencilSquareIcon className="w-5 h-5" />
                          </Link> 

                          <button
                            onClick={() => deleteAccount(accounting)}
                            className="text-red-500"
                          >
                            <TrashIcon className="w-5 h-5" />
                          </button>
                        </td>
                      </tr>
                            
                      {/* Detail Accounting Table */}
                      {accounting.detail_accounting &&
                        accounting.detail_accounting.length > 0 && (
                          <tr >
                            <td colSpan="6">
                              <table className="w-full max-w-5xl mx-auto  text-center text-sm rtl:text-center text-gray-500 dark:text-gray-400 border mt-2">
                                <thead className="text-xs text-gray-700 uppercase bg-gray-100 dark:bg-gray-700">
                                  <tr>
                                    <th className="px-3 py-2">STATO</th>
                                    <th className="px-3 py-2">
                                      MODALITÀ PAGAMENTO
                                    </th>
                                    <th className="px-3 py-2">DATA SCADENZA</th>
                                    <th className="px-3 py-2">IMPORTO</th>
                                    <th className="px-3 py-2">NOTE</th>
                                    <th className="px-3 py-2">AZIONI</th>
                                  </tr>
                                </thead>
                                <tbody>
                                {/* <pre>{JSON.stringify(accounting.detail_accounting,undefined, 2)}</pre> */}
                                  {accounting.detail_accounting.map(
                                    (detail) => (
                                      <tr key={detail.id} className="mb-3">
                                        <td className="px-3 py-2">
                                          {/* {detail.stato} */}
                                           <span
                                                                    className={
                                                                      "px-2 py-1 rounded text-white " +
                                                                      ACCOUNTING_STATUS_CLASS_MAP[detail.stato]
                                                                    }
                                                                  >
                                                                    {ACCOUNTING_STATUS_TEXT_MAP[detail.stato]}
                                                                  </span>
                                        </td>
                                        <td className="px-3 py-2">
                                          {detail.modalitaPagamento}
                                        </td>
                                        <td className="px-3 py-2">
                                          {detail.dataScadenzaPagamento}
                                        </td>
                                        <td className="px-3 py-2">
                                          {detail.importoPagamento}
                                        </td>
                                        <td className="px-3 py-2">
                                          {detail.note}
                                        </td>
                                        <td className="px-5 py-2 ">
                                          <Link
                                            href={route(
                                              "detailaccounting.edit",
                                              detail.id
                                            )}
                                            className="font-medium text-blue-600"
                                          >
                                            <PencilSquareIcon className="w-5 h-5" />
                                          </Link>
                                        </td>
                                      </tr>                                     
                                     
                                    )
                                  )}
                                </tbody>
                              </table>
                              <div className="mt-10 h-0.5 bg-black"></div><br />
                            </td>
                          </tr>
                        )}
                    </React.Fragment>
                  ))}
                </tbody>

              </table>
              <Pagination links={accountings.meta.links} />
            </div>
          </div>
        </div>
      </div>
    </AuthenticatedLayout>
  );
}
